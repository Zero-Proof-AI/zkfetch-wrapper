{
  "name": "zkfetch-wrapper",
  "version": "1.0.0",
  "description": "Node.js wrapper for Reclaim Protocol zkFetch SDK with on-chain proof support",
  "main": "index.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zero-Proof-AI/zkfetch-wrapper.git"
  },
  "scripts": {
    "start": "cp --update=none -r ./lib/@reclaimprotocol/zk-symmetric-crypto/resources ./node_modules/@reclaimprotocol/zk-symmetric-crypto/ & node index.js",
    "dev": "nodemon index.js",
    "test": "node tests/test-sdk-verification.js",
    "test:sdk": "node tests/test-sdk-verification.js",
    "test:httpbin": "node tests/test-httpbin-origin.js",
    "test:onchain": "node tests/test-onchain-quick.js",
    "test:onchain:full": "node tests/test-onchain.js",
    "test:selective": "node tests/test-selective-disclosure.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@reclaimprotocol/js-sdk": "5.8.2",
    "@reclaimprotocol/zk-fetch": "1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "ethers": "^6.16.0",
    "express": "^4.18.0",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "axios": "^1.13.2",
    "eslint": "^8.57.0",
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
