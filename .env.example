# Reclaim Protocol application credentials (https://dev.reclaimprotocol.org/)
RECLAIM_APP_ID=0xYourAppIdHere
RECLAIM_APP_SECRET=0xYourAppSecretHere

# Server
PORT=8003
NODE_ENV=development

# Optional: route through TEE-backed flow when supported by the SDK
USE_TEE=false
# Optional: override the Reclaim provider id
RECLAIM_PROVIDER_ID=

# Optional: on-chain tests (tests/test-onchain*.js, toolbox/check-contract-witnesses.js)
SEPOLIA_RPC_URL=
RECLAIM_ADDRESS=0xAe94FB09711e1c6B057853a515483792d8e474d0
# Only needed by test:onchain:full, which sends a real Sepolia transaction. Use a throwaway key.
PRIVATE_KEY=

# Set to "true" to write generated proofs to ./generated_proof.json
TESTMODE=false
